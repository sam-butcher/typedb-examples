{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typedb-cloudflare-worker",
  "main": "src/index.tsx",
  "compatibility_date": "2025-09-01",
  // Plain (non-secret) configuration. TYPEDB_ADDRESS, TYPEDB_USERNAME and TYPEDB_PASSWORD are secrets:
  // put them in .dev.vars locally and set them with `wrangler secret put` (or the Deploy button) in production.
  "vars": {
    "TYPEDB_DATABASE": "cloudflare_demo"
  },
  "observability": { "enabled": true }
}
