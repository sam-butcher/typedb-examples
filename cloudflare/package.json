{
  "name": "typedb-cloudflare-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "typecheck": "wrangler types --include-env=false && tsc --noEmit",
    "db:setup": "tsx --env-file-if-exists=.dev.vars scripts/setup.ts"
  },
  "dependencies": {
    "@typedb/driver-http": "3.15.0",
    "hono": "4.13.22"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "4.168.0"
  },
  "cloudflare": {
    "bindings": {
      "TYPEDB_ADDRESS": {
        "description": "HTTP address of your TypeDB Cloud cluster, e.g. https://<cluster>.cloud.typedb.com:8000"
      },
      "TYPEDB_USERNAME": {
        "description": "TypeDB username"
      },
      "TYPEDB_PASSWORD": {
        "description": "TypeDB password"
      }
    }
  }
}
